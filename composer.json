{
    "name": "africs/gmb-pay",
    "description": "Unified Laravel package for Gambian payment gateways (Wave, Modempay, Waychit, Gamswitch, QMoney, Africell Money). One install, one API, one webhook surface.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "payment",
        "payment-gateway",
        "gambia",
        "mobile-money",
        "wave",
        "modempay",
        "waychit",
        "gamswitch",
        "qmoney",
        "africell-money"
    ],
    "authors": [
        {
            "name": "Africs",
            "email": "awdi.africa@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Africs\\GmbPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Africs\\GmbPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Africs\\GmbPay\\GmbPayServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
